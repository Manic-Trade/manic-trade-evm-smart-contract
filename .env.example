# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it.
#
# RPC URLs for Robinhood Chain (https://docs.robinhood.com/chain/connecting).
#   testnet: chain id 46630, where we deploy and test
#   mainnet: chain id 4663, used read-only by the fork tests (real USDG)
ROBINHOOD_TESTNET_RPC_URL=
# The public mainnet RPC, https://rpc.mainnet.chain.robinhood.com, is enough for the fork tests (test/fork/). Without
# this variable they are skipped.
ROBINHOOD_RPC_URL=
# Optional: the block the fork tests fork. The public RPC keeps only minutes of state, so leave it empty (the latest
# block), or set it to the latest block once for a run: ROBINHOOD_FORK_BLOCK=$(cast block-number --rpc-url ...).
# An older block needs an archive RPC.
ROBINHOOD_FORK_BLOCK=

# No private keys here. Deployer keys live in Foundry's encrypted keystore:
#   cast wallet import manic-deployer --interactive
#   forge script ... --account manic-deployer
