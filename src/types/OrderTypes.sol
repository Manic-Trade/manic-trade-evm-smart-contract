pragma solidity 0.8.38;

import {Side} from "./StorageTypes.sol";

// The calldata structs of `open` and `sell` (docs/ARCHITECTURE.md §6.7, §7). The user signs `OpenOrder` and
// `SellOrder` with EIP-712 before any price is known ("commit first, price after"). Their fields must stay in exactly
// the order of their EIP-712 type strings, which the backend hashes too, so changing either is an ABI change.
// `OpenTerms` and `SellTerms` are what the relayer adds at the price tick; the contract checks them against the
// market's bounds.

/// @notice An order to open a position, signed by the user (EIP-712) before the price is known.
/// @dev EIP-712 type string, one line without spaces after the commas (`side` encodes as `uint8`):
///      OpenOrder(bytes32 positionId,address user,bytes32 marketId,uint16 leverage,uint8 side,uint64 stake,
///      uint16 durationSecs,uint48 notBefore,uint48 deadline)
///      The user signs only the order, so the order must name the leverage, and with it the market (ADR 0008).
struct OpenOrder {
    bytes32 positionId; // generated by the backend: random, never zero, single use (also the EIP-3009 nonce)
    address user; // the signer, who owns the position
    bytes32 marketId; // the market's Pyth feed id
    uint16 leverage; // the market's leverage, as the user chose it; signed, so no relayer can open at another
    Side side; // Call = Higher, Put = Lower
    uint64 stake; // the margin, in base units
    uint16 durationSecs; // one of the market's enabled durations
    uint48 notBefore; // the entry tick must be published at or after this
    uint48 deadline; // block.timestamp must be at most this
}

/// @notice The terms the relayer adds to an `OpenOrder` at the price tick.
/// @dev `open` checks each one against the market's bounds and the order (§8.2), so a relayer can only pick terms
///      inside what the admin allowed.
struct OpenTerms {
    int64 entryPrice; // the entry tick's price, at the market's exponent
    uint48 entryPublishTime; // the entry tick's time: fresh, and at or after the order's notBefore
    uint32 thetaE7; // the liquidation distance θ × 1e7, inside the duration rule's range
    uint16 floorBps; // inside the market's floor range
    uint16 capBps; // inside the market's cap range, and at least the floor
}

/// @notice The user's EIP-3009 `ReceiveWithAuthorization` for the stake: exactly `stake`, from the user to the
///         contract, with the order's `positionId` as its nonce.
/// @dev The token checks the signature (ERC-1271 wallets included). Only the receiving contract can submit it, so
///      nobody can front-run it, and nothing is left approved afterwards.
struct StakeAuth {
    uint256 validAfter; // the authorisation is valid after this time...
    uint256 validBefore; // ...and before this one
    bytes signature; // the user's signature, passed through to the token
}

/// @notice An order to sell a position early, signed by the position's user (EIP-712).
/// @dev EIP-712 type string: SellOrder(bytes32 positionId,uint64 minAmount,uint48 notBefore,uint48 deadline)
struct SellOrder {
    bytes32 positionId; // the position to sell; it closes on the first sale, so the order can't be replayed
    uint64 minAmount; // the least the user accepts for it, before the winner fee
    uint48 notBefore; // the sale's price tick must be published at or after this
    uint48 deadline; // block.timestamp must be at most this
}

/// @notice The terms the relayer adds to a `SellOrder` at the price tick.
/// @dev `sell` checks them with `LeverageMath.checkSell` (§8.3): the valuation can't exceed the current payout,
///      and the early-sell fee (`valuation - sellAmount`) can't exceed the market's maximum.
struct SellTerms {
    int64 price; // the tick's price, at the market's exponent
    uint48 publishTime; // the tick's time: fresh, inside the sell window, and at or after the order's notBefore
    uint64 valuation; // what the position is worth now, before the early-sell fee
    uint64 sellAmount; // what the user gets, before the winner fee
}
